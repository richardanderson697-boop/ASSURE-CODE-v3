# ============================================================
# ASSURE CODE — Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# ── Server Configuration ────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (Supabase PostgreSQL) ──────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# ── Redis (BullMQ Job Queues) ───────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka Event Bus ─────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
# For production with SASL authentication:
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# ── AI API Keys ─────────────────────────────────────────────
# Claude (Anthropic) - Used for compliance diff generation
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI - Used for embeddings and scanning
OPENAI_API_KEY=sk-...

# Google Gemini - Used for spec generation and drafting
GEMINI_API_KEY=...

# ── GitHub Integration ──────────────────────────────────────
# Create a GitHub App at https://github.com/settings/apps/new
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID=

# ── JWT Authentication ──────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ── Stripe Billing (Optional) ───────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Frontend URLs (for CORS) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SCRAPER_URL=http://localhost:8000

# ── Worker Configuration ────────────────────────────────────
# Number of concurrent workers for job processing
WORKER_CONCURRENCY=3
